# ---------------------------------------------------------------------------
# Agonis Partners — backend environment variables
#
# Local dev:  copy this file to .env.local and fill in the values.
# Production: add the same keys in Vercel → Project → Settings → Environment
#             Variables, then redeploy.
#
# .env.local is gitignored. Never commit real credentials.
# ---------------------------------------------------------------------------


# --- Database (MongoDB Atlas) ----------------------------------------------
# Your cluster's SRV connection string. Replace <db_password> with the real password.
#
# If the password contains any of  @ : / ? # [ ] %  it MUST be percent-encoded
# or the driver will fail to parse the URI. Quick way to encode it:
#   node -e "console.log(encodeURIComponent('your password here'))"
MONGODB_USERNAME="your_mongodb_username"
MONGODB_PASSWORD="your_mongodb_password"
MONGODB_URI="mongodb+srv://your_mongodb_username:your_mongodb_password@cluster0.dwo5xvn.mongodb.net"

# Which database inside the cluster to use.
# Required here because the connection string above has no database in its
# path — without this the driver would silently fall back to "test".
MONGODB_DB="agonis"


# --- Email (Gmail SMTP via Nodemailer) -------------------------------------
# GMAIL_APP_PASSWORD is a 16-character Google App Password, NOT your normal
# account password. 2-Step Verification must be on to generate one:
#   https://myaccount.google.com/apppasswords
# Paste it without spaces.
GMAIL_USER="youraddress@gmail.com"
GMAIL_APP_PASSWORD="abcdefghijklmnop"

# Where new brand submissions are delivered.
ADMIN_EMAIL="xaviernelson121@gmail.com"

# Display name on outgoing mail.
MAIL_FROM_NAME="Agonis Partners"


# --- Optional overrides -----------------------------------------------------
# Only set these to use a provider other than Gmail.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"

# Used for absolute links inside emails.
NEXT_PUBLIC_SITE_URL="https://agonispartners.com"
